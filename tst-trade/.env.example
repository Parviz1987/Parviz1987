# Panelə giriş parolu: deploy/setup.sh və deploy/set-password.sh yalnız onun scrypt hash-ını yazır.
# Yerli sınaqda açıq parol da olar: APP_PASSWORD=test
APP_PASSWORD_HASH=
# Açarları şifrələyən gizli söz (məcburi, uzun təsadüfi mətn: python3 -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=
# Canlı qiymət mənbəyi: goldapi (pulsuz, açarsız) | twelvedata (açar admin panelində) | demo (yalnız sınaq üçün, DEMO yazılır)
PRICE_PROVIDER=goldapi
# Qiymət soruşma aralığı, saniyə
PRICE_POLL_SECONDS=15
# Brauzerdə https yoxdursa (yalnız yerli sınaq) 0 yazın
COOKIE_SECURE=1
DB_PATH=data/lab.sqlite3
